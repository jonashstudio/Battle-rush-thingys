<Item class="DataModel" referent="RBX0"><Properties><string name="Name">Battle Rush</string></Properties><Item class="Workspace" referent="RBX67B734A49C3F47B9984386091AC04073"><Properties><string name="Name">Workspace</string></Properties><Item class="Model" referent="RBX171B8C532B314462947932EE98762048"><Properties><string name="Name">AdminMap</string><bool name="Archivable">true</bool></Properties><Item class="Part" referent="RBXF2706855505F4C6C97747443139FFA1D"><Properties><string name="Name">ArenaFloor</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Vector3 name="Size"><X>180</X><Y>4</Y><Z>180</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.21568627450980393</R><G>0.24313725490196078</G><B>0.3058823529411765</B></Color3><string name="Material">Plastic</string><float name="Transparency">0</float><string name="TopSurface">Studs</string><string name="BottomSurface">Inlet</string></Properties></Item><Item class="Part" referent="RBX1208434B8A594E56AF370E91924ACC7C"><Properties><string name="Name">NorthWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Vector3 name="Size"><X>180</X><Y>24</Y><Z>5</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>12</Y><Z>-92</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.13725490196078433</R><G>0.1568627450980392</G><B>0.21568627450980393</B></Color3><string name="Material">Plastic</string><float name="Transparency">0</float><string name="TopSurface">Studs</string><string name="BottomSurface">Inlet</string></Properties></Item><Item class="Part" referent="RBX46797B325DB64AE89A6083B9A5C0BAAE"><Properties><string name="Name">SouthWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Vector3 name="Size"><X>180</X><Y>24</Y><Z>5</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>12</Y><Z>92</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.13725490196078433</R><G>0.1568627450980392</G><B>0.21568627450980393</B></Color3><string name="Material">Plastic</string><float name="Transparency">0</float><string name="TopSurface">Studs</string><string name="BottomSurface">Inlet</string></Properties></Item><Item class="Part" referent="RBX4EBCA447E57B4F898B15B68FF796C4E6"><Properties><string name="Name">EastWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Vector3 name="Size"><X>5</X><Y>24</Y><Z>180</Z></Vector3><CoordinateFrame name="CFrame"><X>92</X><Y>12</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.13725490196078433</R><G>0.1568627450980392</G><B>0.21568627450980393</B></Color3><string name="Material">Plastic</string><float name="Transparency">0</float><string name="TopSurface">Studs</string><string name="BottomSurface">Inlet</string></Properties></Item><Item class="Part" referent="RBX0FC3D5719AA846079876AF303D0BE5A9"><Properties><string name="Name">WestWall</string><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><Vector3 name="Size"><X>5</X><Y>24</Y><Z>180</Z></Vector3><CoordinateFrame name="CFrame"><X>-92</X><Y>12</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.13725490196078433</R><G>0.1568627450980392</G><B>0.21568627450980393</B></Color3><string name="Material">Plastic</string><float name="Transparency">0</float><string name="TopSurface">Studs</string><string name="BottomSurface">Inlet</string></Properties></Item><Item class="Part" referent="RBXB3937A396F